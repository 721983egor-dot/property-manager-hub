# Домен, на котором будет работать приложение
DOMAIN=residence-more.ru

# Пароль суперпользователя PostgreSQL (придумайте сложный)
POSTGRES_PASSWORD=change-me-strong-password

# JWT-секрет для авторизации Supabase (минимум 32 символов)
JWT_SECRET=change-me-jwt-secret-min-32-chars

# Ключи Supabase self-hosted (сгенерируются при первом запуске)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_service_role_...
SUPABASE_PROJECT_ID=local

# MinIO (S3-совместимое хранилище фото)
MINIO_ROOT_USER=rm-os
MINIO_ROOT_PASSWORD=change-me-minio-password

# Deploy-агент: секретный токен для вызова из RM OS
DEPLOY_AGENT_TOKEN=change-me-deploy-token

# GitHub-репозиторий (Cursor пушит сюда, Beget забирает код)
GITHUB_REPO=https://github.com/721983egor-dot/property-manager-hub.git

# Необязательно: чтобы после «Обновить систему» ветка main на GitHub совпала с тестом
GITHUB_TOKEN=

# Каталог тестовой копии на сервере
PREVIEW_REPO_DIR=/opt/rm-os/preview

# Пароль на тестовые адреса (клиенты и поиск их не видят).
# Сгенерировать свой хеш: htpasswd -nbB preview 'ваш-пароль'
# В этом файле каждый $ в хеше пишите как $$.
PREVIEW_USER=preview
PREVIEW_PASSWORD_HASH=$$2y$$05$$j4UNi.r1VeA69TkNtGvl4OviK0bwhmnVUrV.vpPWH1LCcG9Nle1OK

# API-ключи площадок (перенесите из Lovable)
CIAN_API_KEY=
YANDEX_REALTY_TOKEN=
YANDEX_GEOCODER_API_KEY=
YANDEX_MAPS_JS_API_KEY=
YANDEX_SUGGEST_API_KEY=
LOVABLE_CRON_SECRET=

# Ассистент и Telegram-бот. TELEGRAM_API_KEY — токен от @BotFather (можно как TELEGRAM_BOT_TOKEN).
LOVABLE_API_KEY=
TELEGRAM_API_KEY=
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Бэкапы во внешнее S3-совместимое хранилище (опционально)
BACKUP_BUCKET=rm-os-backups
BACKUP_ENDPOINT=https://s3.storage.provider.com
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=

# Email для уведомлений Let's Encrypt (опционально)
TLS_EMAIL=you@example.com
