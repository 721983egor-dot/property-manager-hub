{
    auto_https disable_redirects
}

# Разрешаем служебным адресам отвечать с рабочего и тестового RM OS / сайта
(cors) {
    @rmos header Origin https://rm-os.{$DOMAIN}
    @preview_rmos header Origin https://preview-rm-os.{$DOMAIN}
    @preview_site header Origin https://preview.{$DOMAIN}

    header @rmos Access-Control-Allow-Origin "https://rm-os.{$DOMAIN}"
    header @preview_rmos Access-Control-Allow-Origin "https://preview-rm-os.{$DOMAIN}"
    header @preview_site Access-Control-Allow-Origin "https://preview.{$DOMAIN}"

    header {
        Access-Control-Allow-Credentials "true"
        Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        Access-Control-Allow-Headers "authorization, apikey, content-type, x-client-info, prefer, range, x-supabase-api-version, accept-profile, content-profile"
        Access-Control-Expose-Headers "content-range, content-length, x-total-count"
        Vary "Origin"
        defer
    }
    @preflight method OPTIONS
    respond @preflight 204
}

# База, вход и фото — общие. Само приложение подключается на каждом домене отдельно.
# Снимаем CORS бэкенда: иначе два Access-Control-Allow-Origin и браузер блокирует вход.
(services) {
    handle_path /auth/v1/* {
        import cors
        reverse_proxy supabase-auth:9999 {
            header_down -Access-Control-Allow-Origin
            header_down -Access-Control-Allow-Credentials
        }
    }
    handle_path /rest/v1/* {
        import cors
        reverse_proxy supabase-rest:3000 {
            header_down -Access-Control-Allow-Origin
            header_down -Access-Control-Allow-Credentials
        }
    }
    handle_path /storage/v1/* {
        import cors
        reverse_proxy supabase-storage:5000 {
            header_down -Access-Control-Allow-Origin
            header_down -Access-Control-Allow-Credentials
        }
    }
    encode gzip
}

{$DOMAIN} {
    tls {$TLS_EMAIL}
    import services
    request_body {
        max_size 2GB
    }
    handle {
        reverse_proxy app:3000
    }
}

# Служебный адрес для входа менеджеров: корень ведёт сразу в RM OS
rm-os.{$DOMAIN} {
    tls {$TLS_EMAIL}
    redir / /objects 302
    import services
    request_body {
        max_size 2GB
    }
    handle {
        reverse_proxy app:3000
    }
}

# Тестовый сайт закрыт паролем браузера и не индексируется.
# Запросы с Authorization: Bearer не трогаем: иначе RM OS после входа снова просит пароль страницы.
(preview_headers) {
    header X-Robots-Tag "noindex, nofollow, noarchive"
    header Referrer-Policy "no-referrer"
    handle /robots.txt {
        header Content-Type "text/plain; charset=utf-8"
        respond "User-agent: *\nDisallow: /\n" 200
    }
}

(preview_lock) {
    import preview_headers
    @preview_pages {
        not path /auth/v1/* /rest/v1/* /storage/v1/* /api/* /robots.txt /.well-known/acme-challenge/*
        not header Authorization Bearer*
    }
    basic_auth @preview_pages {
        {$PREVIEW_USER} {$PREVIEW_PASSWORD_HASH}
    }
}

# Тестовая копия сайта: правки с ветки preview, рабочий сайт не трогаем
preview.{$DOMAIN} {
    tls {$TLS_EMAIL}
    import preview_lock
    import services
    request_body {
        max_size 2GB
    }
    handle {
        reverse_proxy preview-app:3000
    }
}

# Тестовый RM OS: свой вход сотрудников, без пароля страницы — иначе окно браузера зацикливается
preview-rm-os.{$DOMAIN} {
    tls {$TLS_EMAIL}
    import preview_headers
    import services
    request_body {
        max_size 2GB
    }
    handle / {
        redir * /objects 302
    }
    handle {
        reverse_proxy preview-app:3000
    }
}

# GitHub дергает агент по токену; снаружи это не сайт
deploy.{$DOMAIN} {
    tls {$TLS_EMAIL}
    header X-Robots-Tag "noindex, nofollow, noarchive"
    handle /robots.txt {
        header Content-Type "text/plain; charset=utf-8"
        respond "User-agent: *\nDisallow: /\n" 200
    }
    reverse_proxy deploy-agent:8080
}

# Доступ по IP до переключения DNS
:80 {
    import services
    request_body {
        max_size 2GB
    }
    handle {
        reverse_proxy app:3000
    }
}
